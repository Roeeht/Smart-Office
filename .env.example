# Smart Office Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# JWT Configuration (REQUIRED - MUST BE SET)
# ===========================================
# Shared secret for HMAC-SHA256 signing (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=<generate-with-openssl-rand-base64-32>

# Token issuer identifier
JWT_ISSUER=smart-office

# Token audience identifier
JWT_AUDIENCE=smart-office-api

# Token expiration in minutes
JWT_EXP_MINUTES=30

# ===========================================
# PostgreSQL (Auth Service Database)
# ===========================================
POSTGRES_USER=authuser
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_DB=authdb

# ===========================================
# MongoDB (Resource Service Database)
# ===========================================
MONGO_USER=mongouser
MONGO_PASSWORD=<your-mongo-password>
MONGODB_DATABASE_NAME=smart_office

# ===========================================
# Admin Seeding
# ===========================================
# Initial Admin user created on first startup
SEED_ADMIN_NAME=admin
SEED_ADMIN_PASSWORD=<your-admin-password>

# ===========================================
# ASP.NET Core Environment
# ===========================================
ASPNETCORE_ENVIRONMENT=Production
